<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🎡 Spin Wheel</title>

<style>
:root {
  --bg: #eef1f6;
  --panel: #ffffff;
  --text: #172033;
  --muted: #64748b;
  --accent: #6c5ce7;
  --border: #e2e8f0;
}
body.dark {
  --bg: #10131f;
  --panel: #1c2233;
  --text: #f8fafc;
  --muted: #aab4c8;
  --accent: #a78bfa;
  --border: #353c50;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  min-height: 100vh;
  padding: 20px;
  font-family: system-ui, Arial, sans-serif;
  color: var(--text);
  background-color: #eef1f6;
  background-image: 
    radial-gradient(circle, rgba(108,92,231,0.08) 1.5px, transparent 1.5px),
    linear-gradient(180deg, #f8fafc 0%, #e6eaf2 100%);
  background-size: 28px 28px, 100% 100%;
  background-attachment: fixed;
  transition: background .25s, color .25s;
}
body.dark {
  background-color: #10131f;
  background-image: 
    radial-gradient(circle, rgba(167,139,250,0.08) 1.5px, transparent 1.5px),
    linear-gradient(180deg, #151a28 0%, #0c0f16 100%);
  background-size: 28px 28px, 100% 100%;
  background-attachment: fixed;
}
header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  max-width: 1000px;
  margin: 0 auto 24px;
}
h1 { margin: 0; font-size: 27px; }
.subtitle { color: var(--muted); margin-top: 5px; }
button, input { font: inherit; }
button {
  border: 0;
  border-radius: 10px;
  padding: 10px 14px;
  background: var(--accent);
  color: white;
  cursor: pointer;
  font-weight: 650;
}
button:disabled { opacity: .45; cursor: not-allowed; }
button.secondary {
  background: var(--panel);
  color: var(--text);
  border: 1px solid var(--border);
}
button.danger { background: #e74c3c; }
button.small { padding: 6px 10px; font-size: 13px; }
.layout {
  max-width: 1000px;
  margin: auto;
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(270px, .75fr);
  gap: 20px;
}
.panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 20px;
  min-width: 0;
  box-shadow: 0 6px 20px #0f172a12;
}
.wheel-wrap {
  position: relative;
  width: min(100%, 440px);
  margin: 8px auto 18px;
}
canvas { width: 100%; height: auto; display: block; }
.pointer {
  position: absolute;
  z-index: 2;
  top: -3px;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 17px solid transparent;
  border-right: 17px solid transparent;
  border-top: 35px solid #ef4444;
  filter: drop-shadow(0 2px 2px #0004);
}
.spin-btn {
  display: block;
  margin: auto;
  width: min(100%, 240px);
  padding: 15px;
  font-size: 19px;
  background: linear-gradient(135deg,#7c3aed,#4f46e5);
}
.result {
  text-align: center;
  margin-top: 18px;
  min-height: 76px;
}
.result strong {
  display: block;
  font-size: 34px;
  color: var(--accent);
  overflow-wrap: anywhere;
}
h2 { font-size: 19px; margin: 0 0 15px; }
h3 { font-size: 15px; margin: 18px 0 10px; }
.field { margin: 14px 0; }
label { display: block; margin-bottom: 7px; font-size: 14px; }
input[type="number"], input[type="text"] {
  width: 100%;
  background: var(--bg);
  color: var(--text);
  border: 1px solid var(--border);
  padding: 10px;
  border-radius: 9px;
}
input[type="checkbox"] { accent-color: var(--accent); }
input[type="range"] { accent-color: var(--accent); }
.row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}
.hint { font-size: 13px; color: var(--muted); }
.saved-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 9px 0;
  border-bottom: 1px solid var(--border);
  gap: 8px;
}
.saved-item:last-child { border-bottom: 0; }
.empty { color: var(--muted); font-size: 14px; }
hr {
  border: 0;
  border-top: 1px solid var(--border);
  margin: 20px 0;
}
.footer {
  max-width: 1000px;
  margin: 30px auto 0;
  text-align: center;
  font-size: 12px;
  color: var(--muted);
}
@media (max-width: 700px) {
  body { padding: 12px; }
  .layout { grid-template-columns: 1fr; }
  header { align-items: flex-start; }
  h1 { font-size: 22px; }
  .panel { padding: 15px; }
}
</style>
</head>

<body>
<header>
  <div>
    <h1>🎡 Spin Wheel</h1>
    <div class="subtitle">Spin it. Pick a number. Have fun!</div>
  </div>
  <button class="secondary" id="themeBtn">🌙 Dark</button>
</header>

<main class="layout">
  <section class="panel">
    <div class="wheel-wrap">
      <div class="pointer"></div>
      <canvas id="wheel" width="700" height="700"></canvas>
    </div>

    <button class="spin-btn" id="spinBtn">🎯 SPIN NOW</button>

    <div class="result" aria-live="polite">
      <div class="hint" id="resultLabel">Your winning number</div>
      <strong id="result">Ready?</strong>
    </div>

    <div class="row">
      <button id="keepBtn" class="secondary" disabled>⭐ Keep winner</button>
      <button id="removeBtn" class="danger" disabled>🗑️ Remove winner</button>
    </div>

    <p class="hint">Keep saves the result. Remove deletes the winner from the wheel.</p>
  </section>

  <aside class="panel">
    <h2>⚙️ Wheel settings</h2>

    <div class="field">
      <label for="count">Number of options (1–100)</label>
      <input type="number" id="count" min="1" max="100" value="100">
    </div>

    <div class="row">
      <button id="generateBtn">Generate wheel</button>
      <button id="resetBtn" class="secondary">Reset all</button>
    </div>

    <hr>

    <h3>🔊 Sound effects</h3>
    <label><input type="checkbox" id="soundToggle" checked> Enable sounds</label>

    <div class="field">
      <label for="volume">Sound volume</label>
      <input type="range" id="volume" min="0" max="100" value="40"
             style="width:100%">
    </div>

    <hr>

    <h3>🔀 Wheel actions</h3>
    <div class="hint" id="countLabel"></div>
    <div class="row" style="margin-top:10px">
      <button id="restoreBtn" class="secondary small">Restore removed numbers</button>
      <button id="shuffleBtn" class="secondary small">Shuffle</button>
    </div>

    <hr>

    <h3>⭐ Kept results</h3>
    <div id="savedList">
      <p class="empty">No saved results yet.</p>
    </div>
    <button id="clearSavedBtn" class="secondary small"
            style="margin-top:12px">Clear saved results</button>
  </aside>
</main>

<footer class="footer">
  Made by Saneen
</footer>

<script>
const canvas = document.getElementById("wheel");
const ctx = canvas.getContext("2d");
const $ = id => document.getElementById(id);

const colors = [
  "#ef4444", "#f97316", "#f59e0b", "#84cc16",
  "#10b981", "#06b6d4", "#3b82f6", "#6366f1",
  "#8b5cf6", "#d946ef", "#ec4899", "#14b8a6"
];

let numbers = [];
let removedNumbers = [];
let saved = [];
let angle = 0;
let spinning = false;
let lastWinner = null;
let audioContext = null;
let volume = 0.4;

function initialize() {
  numbers = Array.from({length: 100}, (_, i) => String(i + 1));
  removedNumbers = [];
  saved = [];
  angle = 0;
  lastWinner = null;
  $("count").value = 100;
  $("result").textContent = "Ready?";
  $("resultLabel").textContent = "Your winning number";
  $("keepBtn").disabled = true;
  $("removeBtn").disabled = true;
  drawWheel();
  renderLists();
}

function drawWheel() {
  const size = canvas.width;
  const center = size / 2;
  const radius = center - 12;

  ctx.clearRect(0, 0, size, size);

  if (!numbers.length) {
    ctx.beginPath();
    ctx.arc(center, center, radius, 0, Math.PI * 2);
    ctx.fillStyle = "#94a3b8";
    ctx.fill();
    ctx.fillStyle = "#fff";
    ctx.font = "bold 28px Arial";
    ctx.textAlign = "center";
    ctx.fillText("No options!", center, center);
    return;
  }

  const slice = Math.PI * 2 / numbers.length;

  numbers.forEach((number, i) => {
    const start = angle + i * slice - Math.PI / 2;

    ctx.beginPath();
    ctx.moveTo(center, center);
    ctx.arc(center, center, radius, start, start + slice);
    ctx.closePath();
    ctx.fillStyle = colors[i % colors.length];
    ctx.fill();
    ctx.strokeStyle = "#ffffff88";
    ctx.lineWidth = 2;
    ctx.stroke();

    ctx.save();
    ctx.translate(center, center);
    ctx.rotate(start + slice / 2);
    ctx.textAlign = "right";
    ctx.textBaseline = "middle";
    ctx.fillStyle = "#fff";
    const fontSize = numbers.length > 60 ? 15 :
                     numbers.length > 30 ? 18 : 23;
    ctx.font = `bold ${fontSize}px Arial`;
    ctx.shadowColor = "#0005";
    ctx.shadowBlur = 2;
    ctx.fillText(number, radius - 20, 0);
    ctx.restore();
  });

  ctx.beginPath();
  ctx.arc(center, center, 42, 0, Math.PI * 2);
  ctx.fillStyle = "#ffffff";
  ctx.fill();
  ctx.strokeStyle = "#d1d5db";
  ctx.lineWidth = 5;
  ctx.stroke();

  ctx.beginPath();
  ctx.arc(center, center, 29, 0, Math.PI * 2);
  ctx.fillStyle = "#6c5ce7";
  ctx.fill();

  ctx.fillStyle = "#fff";
  ctx.font = "bold 23px Arial";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("GO", center, center);
}

function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g, ch => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;",
    '"': "&quot;", "'": "&#39;"
  })[ch]);
}

function renderLists() {
  $("countLabel").textContent =
    `${numbers.length} options on the wheel`;

  $("savedList").innerHTML = saved.map((n, i) => `
    <div class="saved-item">
      <span>⭐ ${escapeHTML(n)}</span>
      <button class="secondary small" data-unsave="${i}">Remove</button>
    </div>
  `).join("") ||
    '<p class="empty">No saved results yet.</p>';

  $("spinBtn").disabled = spinning || numbers.length === 0;
  $("generateBtn").disabled = spinning;
  $("resetBtn").disabled = spinning;
  $("shuffleBtn").disabled = spinning || numbers.length < 2;
  $("restoreBtn").disabled =
    spinning || removedNumbers.length === 0;
}

function beep(frequency = 600, duration = 0.07, type = "sine") {
  if (!$("soundToggle").checked || volume <= 0) return;

  try {
    audioContext ||= new (window.AudioContext ||
      window.webkitAudioContext)();

    if (audioContext.state === "suspended") {
      audioContext.resume();
    }

    const oscillator = audioContext.createOscillator();
    const gain = audioContext.createGain();

    oscillator.type = type;
    oscillator.frequency.setValueAtTime(
      frequency, audioContext.currentTime
    );

    gain.gain.setValueAtTime(
      volume * 0.15, audioContext.currentTime
    );
    gain.gain.exponentialRampToValueAtTime(
      0.001, audioContext.currentTime + duration
    );

    oscillator.connect(gain);
    gain.connect(audioContext.destination);
    oscillator.start();
    oscillator.stop(audioContext.currentTime + duration);
  } catch (error) {
    console.warn("Audio unavailable", error);
  }
}

$("volume").addEventListener("input", e => {
  volume = Number(e.target.value) / 100;
});

function spin() {
  if (spinning || !numbers.length) return;

  spinning = true;
  lastWinner = null;
  $("keepBtn").disabled = true;
  $("removeBtn").disabled = true;
  $("resultLabel").textContent = "Spinning...";
  $("result").textContent = "🎡";
  renderLists();

  const count = numbers.length;
  const slice = 2 * Math.PI / count;
  const winnerIndex = Math.floor(Math.random() * count);

  const current =
    ((angle % (2 * Math.PI)) + 2 * Math.PI) % (2 * Math.PI);

  const targetAngle = -winnerIndex * slice - slice / 2;
  const delta =
    ((targetAngle - current) % (2 * Math.PI) + 2 * Math.PI)
    % (2 * Math.PI) +
    (5 + Math.floor(Math.random() * 4)) * 2 * Math.PI;

  const startAngle = angle;
  const endAngle = angle + delta;
  const startTime = performance.now();
  const duration = 4500;
  let lastTick = -1;

  function animate(now) {
    const progress = Math.min(1, (now - startTime) / duration);
    const eased = 1 - Math.pow(1 - progress, 4);

    angle = startAngle + delta * eased;
    drawWheel();

    const tick = Math.floor(eased * delta / slice);
    if (tick !== lastTick) {
      lastTick = tick;
      beep(300 + Math.random() * 250, 0.035, "square");
    }

    if (progress < 1) {
      requestAnimationFrame(animate);
      return;
    }

    angle = endAngle;
    drawWheel();

    const pointerAngle = Math.PI * 1.5;
    const relative =
      ((pointerAngle - angle) % (2 * Math.PI) + 2 * Math.PI)
      % (2 * Math.PI);

    const actualIndex = Math.floor(relative / slice) % count;
    lastWinner = numbers[actualIndex];

    $("resultLabel").textContent = "🎉 The winning number is";
    $("result").textContent = lastWinner;

    spinning = false;
    $("keepBtn").disabled = false;
    $("removeBtn").disabled = false;
    renderLists();

    beep(660, 0.15);
    setTimeout(() => beep(880, 0.22), 130);
  }

  requestAnimationFrame(animate);
}

$("spinBtn").addEventListener("click", spin);

$("generateBtn").addEventListener("click", () => {
  const count = Math.max(1, Math.min(100,
    parseInt($("count").value, 10) || 1));

  $("count").value = count;
  numbers = Array.from({length: count}, (_, i) => String(i + 1));
  removedNumbers = [];
  lastWinner = null;
  angle = 0;
  $("resultLabel").textContent = "Your winning number";
  $("result").textContent = "Ready?";
  $("keepBtn").disabled = true;
  $("removeBtn").disabled = true;
  drawWheel();
  renderLists();
});

$("keepBtn").addEventListener("click", () => {
  if (lastWinner === null) return;
  saved.push(lastWinner);
  beep(700, 0.1);
  renderLists();
});

$("removeBtn").addEventListener("click", () => {
  if (lastWinner === null || spinning) return;

  const index = numbers.indexOf(lastWinner);
  if (index !== -1) {
    removedNumbers.push(numbers[index]);
    numbers.splice(index, 1);
  }

  lastWinner = null;
  $("resultLabel").textContent = "Winner removed from wheel";
  $("result").textContent = "Removed!";
  $("keepBtn").disabled = true;
  $("removeBtn").disabled = true;
  drawWheel();
  renderLists();
});

$("restoreBtn").addEventListener("click", () => {
  const available = 100 - numbers.length;
  numbers.push(...removedNumbers.splice(0, available));
  drawWheel();
  renderLists();
});

$("shuffleBtn").addEventListener("click", () => {
  for (let i = numbers.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [numbers[i], numbers[j]] = [numbers[j], numbers[i]];
  }

  lastWinner = null;
  drawWheel();
  renderLists();
});

$("savedList").addEventListener("click", e => {
  const btn = e.target.closest("[data-unsave]");
  if (!btn) return;
  saved.splice(Number(btn.dataset.unsave), 1);
  renderLists();
});

$("clearSavedBtn").addEventListener("click", () => {
  if (saved.length && confirm("Clear all saved results?")) {
    saved = [];
    renderLists();
  }
});

$("resetBtn").addEventListener("click", () => {
  if (confirm("Reset the wheel and saved results?")) {
    initialize();
  }
});

$("themeBtn").addEventListener("click", () => {
  document.body.classList.toggle("dark");
  const dark = document.body.classList.contains("dark");
  $("themeBtn").textContent = dark ? "☀️ Light" : "🌙 Dark";
});

initialize();
</script>
</body>
</html>